# Offline mode is the safe default. Set bailian or openai_compatible after adding a key.
AGENTOS_PROVIDER=mock

# Suggested models include:
# qwen3.8-flash, qwen3.8-27b, kimi-k3, qwen3.8-max-0902,
# deepseek-v4.1-flash, deepseek-v4.1-flash-1017
AGENTOS_MODEL=qwen3.8-flash
# The effective endpoint is inferred from the key. Ordinary sk- keys (including
# new-user free quota) use the standard endpoint; sk-sp- uses Token Plan.
AGENTOS_BAILIAN_MODE=token_plan

# Put the real key only in .env. Free-quota/general keys begin with sk-;
# Token Plan subscription keys begin with sk-sp-.
DASHSCOPE_API_KEY=

# Token Plan endpoint is resolved automatically. Usually leave this empty.
DASHSCOPE_BASE_URL=

# Only for pay_as_you_go workspace-specific endpoints:
AGENTOS_BAILIAN_WORKSPACE_ID=
AGENTOS_BAILIAN_REGION=cn-beijing
AGENTOS_TIMEOUT_SECONDS=30
# AgentRuntimeService raises structured orchestration calls to at least 120s;
# this value remains the timeout for direct /api/chat calls.
AGENTOS_MAX_CONCURRENCY=4
# false disables Qwen3 thinking mode (much lower latency and output tokens)
AGENTOS_ENABLE_THINKING=false
AGENTOS_DATABASE=data/agentos.db
AGENTOS_LOG_LEVEL=INFO
AGENTOS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5


# For any other OpenAI-compatible endpoint, set AGENTOS_PROVIDER=openai_compatible and:
# AGENTOS_BASE_URL=https://api.example.com/v1
# AGENTOS_API_KEY=
# (and remove AGENTOS_ENABLE_THINKING, which only Qwen endpoints accept)
